# ---- ฐานข้อมูล PostgreSQL ----
# ตัวเลือก A (Neon): ใส่ Connection String ของ Neon ทั้งสองบรรทัด (ใช้ค่าเดียวกันได้)
# ตัวเลือก B (Docker ในเครื่อง): ใช้ค่าด้านล่างนี้ได้เลย หลังรัน `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reviewtracker"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/reviewtracker"

# URL ของเว็บ (ตอน deploy เปลี่ยนเป็นโดเมนจริง)
NEXTAUTH_URL="http://localhost:3000"
# กุญแจลับสำหรับเซ็น JWT (เปลี่ยนเป็นค่าสุ่มของคุณเอง)
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# ---- อัปโหลดรูปภาพ (Cloudinary) — ไม่บังคับ ถ้าไม่ใส่ระบบอื่นยังใช้ได้ แต่แนบรูปไม่ได้ ----
# ดูค่าได้ที่ Cloudinary Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
